    "# Importar Sympy\n",
    "import sympy as sp\n",
    "\n",
    "\n",
    "# Criando Símbolos\n",
    "a,b = sp.symbols('a b')\n",
    "\n",
    "# Display Latex\n",
    "from IPython.display import display, Math\n",
    "\n",
    "f = x ** 2 + y ** 2 - 25\n",
    "f_cal = sp.lambdify((x, y) ,f, \"numpy\")\n",
    "\n",
    "# Utilizando em solvers...\n",
    "\n",
    "grad = sp.diff((x,y), f)\n",
    "\n"
